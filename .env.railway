# Railway Environment Variables for layer2-data-service
# Copy these to Railway Dashboard → Service Settings → Variables

# ===== API Keys (Required) =====
TAAPI_SECRET=your-taapi-secret-here
CMC_API_KEY=your-coinmarketcap-key-here
FINNHUB_API_KEY=your-finnhub-key-here

# ===== Redis Cache =====
# Use Railway Redis addon (copy from addon settings)
REDIS_URL=redis://default:password@redis.railway.internal:6379

# ===== Debug Mode =====
DEBUG=false

# ===== Note =====
# Railway automatically sets these - DO NOT ADD:
# - PORT (for health check, Railway auto-maps)
# - HOST (0.0.0.0)
# - RUST_LOG (info)
# - RUST_BACKTRACE (1)
#
# Service exposes:
# - PORT (Railway managed) → Health check: GET /health
# - 50051 (internal) → gRPC: MarketDataService
